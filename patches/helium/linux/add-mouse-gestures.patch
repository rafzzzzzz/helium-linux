+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_MOUSE_GESTURE_HANDLER_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_MOUSE_GESTURE_HANDLER_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "ui/compositor/layer_delegate.h"
+#include "ui/events/event_handler.h"
+#include "ui/events/types/event_type.h"
+#include "ui/gfx/geometry/point_f.h"
+
+namespace aura {
+class Window;
+}
+
+namespace ui {
+class Layer;
+class MouseEvent;
+}  // namespace ui
+
+class BrowserView;
+
+// Vivaldi-style mouse gestures: hold the right mouse button over web
+// contents, draw a stroke, release. A right click without movement is
+// replayed to the page so the context menu still works.
+//
+// Installed as a pre-target handler on the browser window's root, so it
+// sees events before the renderer does. This matters on Linux, where the
+// context menu opens on press and extensions can't intercept it.
+class MouseGestureHandler : public ui::EventHandler, public ui::LayerDelegate {
+ public:
+  MouseGestureHandler(BrowserView* browser_view, aura::Window* root_window);
+  MouseGestureHandler(const MouseGestureHandler&) = delete;
+  MouseGestureHandler& operator=(const MouseGestureHandler&) = delete;
+  ~MouseGestureHandler() override;
+
+  // ui::EventHandler:
+  void OnMouseEvent(ui::MouseEvent* event) override;
+
+  // ui::LayerDelegate:
+  void OnPaintLayer(const ui::PaintContext& context) override;
+  void OnDeviceScaleFactorChanged(float old_device_scale_factor,
+                                  float new_device_scale_factor) override {}
+
+ private:
+  enum class State { kIdle, kPressed, kGesturing };
+
+  bool IsInContentsArea(const gfx::PointF& root_location) const;
+  void AddPoint(const gfx::PointF& root_location);
+  void ExecuteGesture();
+  void Reset();
+  void ShowTrail();
+  void HideTrail();
+  void ReplayClick(gfx::PointF root_location, int flags);
+  void DispatchSynthetic(ui::EventType type,
+                         const gfx::PointF& root_location,
+                         int flags);
+
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<aura::Window> root_window_;
+
+  State state_ = State::kIdle;
+  bool replaying_ = false;
+  int press_flags_ = 0;
+
+  gfx::PointF press_location_;
+  // Last point where a direction was recorded.
+  gfx::PointF anchor_;
+  // Directions as Vivaldi encodes them: 'R', 'D', 'L', 'U'.
+  std::string directions_;
+  std::vector<gfx::PointF> trail_;
+  std::unique_ptr<ui::Layer> trail_layer_;
+
+  base::WeakPtrFactory<MouseGestureHandler> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_MOUSE_GESTURE_HANDLER_H_
