+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/mouse_gesture_handler.h"
+
+#include <cmath>
+#include <tuple>
+
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "third_party/skia/include/core/SkPath.h"
+#include "third_party/skia/include/core/SkPathBuilder.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/compositor/layer.h"
+#include "ui/compositor/paint_recorder.h"
+#include "ui/events/base_event_utils.h"
+#include "ui/events/event.h"
+#include "ui/events/event_sink.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/point_conversions.h"
+#include "ui/gfx/geometry/vector2d_f.h"
+#include "ui/views/view.h"
+
+namespace {
+
+// Distance the pointer must travel before a press becomes a gesture.
+constexpr float kActivationDistance = 10.0f;
+// Minimum length of one stroke segment before its direction counts.
+constexpr float kSegmentDistance = 20.0f;
+
+constexpr SkColor kTrailColor = SkColorSetARGB(0xCC, 0x3B, 0x82, 0xF6);
+constexpr float kTrailWidth = 3.0f;
+
+struct GestureBinding {
+  const char* directions;
+  int command_id;
+};
+
+// Mirrors the user's Vivaldi configuration.
+constexpr GestureBinding kBindings[] = {
+    {"L", IDC_BACK},
+    {"R", IDC_FORWARD},
+    {"D", IDC_NEW_TAB},
+    {"U", IDC_CLOSE_TAB},
+    {"UD", IDC_RELOAD},
+    {"DR", IDC_SHOW_BOOKMARK_SIDE_PANEL},
+    {"LD", IDC_SHOW_DOWNLOADS},
+};
+
+char DirectionFor(const gfx::Vector2dF& delta) {
+  if (std::abs(delta.x()) >= std::abs(delta.y())) {
+    return delta.x() > 0 ? 'R' : 'L';
+  }
+  return delta.y() > 0 ? 'D' : 'U';
+}
+
+}  // namespace
+
+MouseGestureHandler::MouseGestureHandler(BrowserView* browser_view,
+                                         aura::Window* root_window)
+    : browser_view_(browser_view), root_window_(root_window) {
+  root_window_->AddPreTargetHandler(this);
+}
+
+MouseGestureHandler::~MouseGestureHandler() {
+  root_window_->RemovePreTargetHandler(this);
+}
+
+void MouseGestureHandler::OnMouseEvent(ui::MouseEvent* event) {
+  if (replaying_) {
+    return;
+  }
+
+  const gfx::PointF location = event->root_location_f();
+
+  switch (event->type()) {
+    case ui::EventType::kMousePressed:
+      if (state_ == State::kIdle && event->IsOnlyRightMouseButton() &&
+          IsInContentsArea(location)) {
+        state_ = State::kPressed;
+        press_flags_ = event->flags();
+        press_location_ = location;
+        anchor_ = location;
+        trail_ = {location};
+        event->SetHandled();
+      } else if (state_ != State::kIdle) {
+        // Another button pressed mid-gesture: abort and eat it.
+        Reset();
+        event->SetHandled();
+      }
+      return;
+
+    case ui::EventType::kMouseMoved:
+    case ui::EventType::kMouseDragged:
+      if (state_ == State::kIdle) {
+        return;
+      }
+      if (state_ == State::kPressed &&
+          (location - press_location_).Length() >= kActivationDistance) {
+        state_ = State::kGesturing;
+        ShowTrail();
+      }
+      if (state_ == State::kGesturing) {
+        AddPoint(location);
+      }
+      event->SetHandled();
+      return;
+
+    case ui::EventType::kMouseReleased:
+      if (state_ == State::kIdle) {
+        return;
+      }
+      if (state_ == State::kGesturing) {
+        ExecuteGesture();
+      } else {
+        ReplayClick(press_location_, press_flags_);
+      }
+      Reset();
+      event->SetHandled();
+      return;
+
+    case ui::EventType::kMouseCaptureChanged:
+      if (state_ != State::kIdle) {
+        Reset();
+      }
+      return;
+
+    default:
+      return;
+  }
+}
+
+bool MouseGestureHandler::IsInContentsArea(
+    const gfx::PointF& root_location) const {
+  views::View* contents = browser_view_->contents_container();
+  if (!contents || !contents->GetVisible()) {
+    return false;
+  }
+  gfx::Point point = gfx::ToFlooredPoint(root_location);
+  views::View::ConvertPointFromWidget(contents, &point);
+  return contents->HitTestPoint(point);
+}
+
+void MouseGestureHandler::AddPoint(const gfx::PointF& root_location) {
+  trail_.push_back(root_location);
+  if (trail_layer_) {
+    trail_layer_->SchedulePaint(gfx::Rect(trail_layer_->size()));
+  }
+
+  const gfx::Vector2dF delta = root_location - anchor_;
+  if (delta.Length() < kSegmentDistance) {
+    return;
+  }
+  const char direction = DirectionFor(delta);
+  if (directions_.empty() || directions_.back() != direction) {
+    directions_.push_back(direction);
+  }
+  anchor_ = root_location;
+}
+
+void MouseGestureHandler::ExecuteGesture() {
+  for (const auto& binding : kBindings) {
+    if (directions_ == binding.directions) {
+      chrome::ExecuteCommand(browser_view_->browser(), binding.command_id);
+      return;
+    }
+  }
+}
+
+void MouseGestureHandler::Reset() {
+  state_ = State::kIdle;
+  directions_.clear();
+  trail_.clear();
+  HideTrail();
+}
+
+void MouseGestureHandler::ShowTrail() {
+  trail_layer_ = ui::Layer::Create(ui::LAYER_TEXTURED);
+  trail_layer_->set_delegate(this);
+  trail_layer_->SetFillsBoundsOpaquely(false);
+  trail_layer_->SetBounds(gfx::Rect(root_window_->bounds().size()));
+  root_window_->layer()->Add(trail_layer_.get());
+  root_window_->layer()->StackAtTop(trail_layer_.get());
+}
+
+void MouseGestureHandler::HideTrail() {
+  trail_layer_.reset();
+}
+
+void MouseGestureHandler::OnPaintLayer(const ui::PaintContext& context) {
+  ui::PaintRecorder recorder(context, trail_layer_->size());
+  if (trail_.size() < 2) {
+    return;
+  }
+
+  SkPathBuilder builder;
+  builder.moveTo(trail_[0].x(), trail_[0].y());
+  for (size_t i = 1; i < trail_.size(); ++i) {
+    builder.lineTo(trail_[i].x(), trail_[i].y());
+  }
+  const SkPath path = builder.detach();
+
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(kTrailWidth);
+  flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+  flags.setStrokeJoin(cc::PaintFlags::kRound_Join);
+  flags.setColor(kTrailColor);
+  recorder.canvas()->DrawPath(path, flags);
+}
+
+void MouseGestureHandler::ReplayClick(gfx::PointF root_location, int flags) {
+  // Dispatch asynchronously so we don't re-enter the event dispatcher
+  // while it's still delivering the original release.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<MouseGestureHandler> self,
+                        gfx::PointF location, int flags) {
+                       if (!self) {
+                         return;
+                       }
+                       self->DispatchSynthetic(ui::EventType::kMousePressed,
+                                               location, flags);
+                       self->DispatchSynthetic(ui::EventType::kMouseReleased,
+                                               location, flags);
+                     },
+                     weak_factory_.GetWeakPtr(), root_location, flags));
+}
+
+void MouseGestureHandler::DispatchSynthetic(ui::EventType type,
+                                            const gfx::PointF& root_location,
+                                            int flags) {
+  aura::WindowTreeHost* host = root_window_->GetHost();
+  if (!host) {
+    return;
+  }
+  // The event sink expects host pixels, not DIPs; without this the replayed
+  // click lands in the wrong place on scaled displays.
+  gfx::PointF location_in_pixels = root_location;
+  host->ConvertDIPToPixels(&location_in_pixels);
+  ui::MouseEvent event(type, location_in_pixels, location_in_pixels,
+                       ui::EventTimeForNow(), flags,
+                       ui::EF_RIGHT_MOUSE_BUTTON);
+  replaying_ = true;
+  std::ignore = host->GetEventSink()->OnEventFromSource(&event);
+  replaying_ = false;
+}
