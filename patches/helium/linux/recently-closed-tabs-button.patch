+// Dropdown listing every recently closed tab, group and window, shown from
+// the "Recently closed tabs" toolbar button. One instance per browser window,
+// owned by the action's callback.
+class RecentlyClosedTabsMenu {
+ public:
+  RecentlyClosedTabsMenu() = default;
+  RecentlyClosedTabsMenu(const RecentlyClosedTabsMenu&) = delete;
+  RecentlyClosedTabsMenu& operator=(const RecentlyClosedTabsMenu&) = delete;
+  ~RecentlyClosedTabsMenu() = default;
+
+  void Toggle(BrowserWindowInterface* bwi, actions::ActionItem* item) {
+    if (menu_runner_ && menu_runner_->IsRunning()) {
+      menu_runner_->Cancel();
+      return;
+    }
+    // A click on the button while the menu is open first closes the menu;
+    // don't let that same click reopen it.
+    if (base::TimeTicks::Now() - menu_closed_time_ < base::Milliseconds(250)) {
+      return;
+    }
+
+    BrowserView* const browser_view =
+        BrowserView::GetBrowserViewForBrowser(bwi);
+    if (!browser_view || !browser_view->toolbar_button_provider()) {
+      return;
+    }
+    views::View* const anchor =
+        browser_view->toolbar_button_provider()
+            ->GetBubbleAnchor(kActionRecentlyClosedTabs)
+            .GetIfView();
+    if (!anchor || !anchor->GetWidget()) {
+      return;
+    }
+
+    menu_runner_.reset();
+    model_ = std::make_unique<RecentTabsSubMenuModel>(
+        browser_view, bwi, /*closed_tabs_only=*/true);
+    item_ = item;
+    item_->SetIsShowingBubble(true);
+    menu_runner_ = std::make_unique<views::MenuRunner>(
+        model_.get(), views::MenuRunner::HAS_MNEMONICS,
+        base::BindRepeating(&RecentlyClosedTabsMenu::OnMenuClosed,
+                            weak_ptr_factory_.GetWeakPtr()));
+    menu_runner_->RunMenuAt(anchor->GetWidget(), nullptr,
+                            anchor->GetAnchorBoundsInScreen(),
+                            views::MenuAnchorPosition::kTopRight,
+                            ui::mojom::MenuSourceType::kNone);
+  }
+
+ private:
+  void OnMenuClosed() {
+    menu_closed_time_ = base::TimeTicks::Now();
+    if (item_) {
+      item_->SetIsShowingBubble(false);
+    }
+  }
+
+  std::unique_ptr<RecentTabsSubMenuModel> model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+  raw_ptr<actions::ActionItem> item_ = nullptr;
+  base::TimeTicks menu_closed_time_;
+  base::WeakPtrFactory<RecentlyClosedTabsMenu> weak_ptr_factory_{this};
+};
